<Window x:Class="DbCodeGen.App.Views.TemplatePackageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模板包管理"
        Width="1000"
        Height="580"
        MinWidth="920"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16" IsEnabled="{Binding IsIdle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：新增模板包 / 导入 zip / 导入文件夹 / 复制 / 重命名 / 导出 / 删除 / 刷新 -->
        <ContentControl Grid.Row="0" Style="{StaticResource DashedGroupBox}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增模板包" Command="{Binding CreatePackageCommand}" />
                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                <Button Content="导入 ZIP" Command="{Binding ImportZipCommand}" />
                <Button Content="导入文件夹" Command="{Binding ImportFolderCommand}" Margin="4,0,0,0" />
                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                <Button Content="复制为…" Command="{Binding BeginCopyCommand}" />
                <Button Content="重命名" Command="{Binding RenamePackageCommand}" Margin="4,0,0,0" ToolTip="重命名选中的用户模板包，内置包只读不可重命名" />
                <Button Content="导出 ZIP" Command="{Binding ExportCommand}" Margin="4,0,0,0" />
                <Button Content="删除" Command="{Binding DeleteCommand}" Margin="4,0,0,0" />
                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </ContentControl>

        <!-- 排序工具条：上移/下移/恢复默认排序 与拖拽提示，包顺序即时写入配置记忆 -->
        <ContentControl Grid.Row="1" Style="{StaticResource DashedGroupBox}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="↑ 上移" Command="{Binding MovePackageUpCommand}" />
                <Button Content="↓ 下移" Command="{Binding MovePackageDownCommand}" Margin="4,0,0,0" />
                <Button Content="恢复默认排序" Command="{Binding ResetPackageOrderCommand}" Margin="4,0,0,0" />
                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                <TextBlock Text="可按住包行拖拽调整顺序"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="Gray" />
            </StackPanel>
        </ContentControl>

        <!-- 复制输入区：进入复制模式后展示，确认复制前需填写新包名 -->
        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="10,8"
                Background="#F3F3F3"
                CornerRadius="4"
                Visibility="{Binding IsCopyModeActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CopySourceDisplay}"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,0,10,0" />
                <TextBox Text="{Binding NewPackageName, UpdateSourceTrigger=PropertyChanged}"
                         Width="220"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0" />
                <Button Content="确认复制" Padding="14,5" Margin="0,0,8,0" Command="{Binding ConfirmCopyCommand}" />
                <Button Content="取消" Padding="14,5" Command="{Binding CancelCopyCommand}" />
            </StackPanel>
        </Border>

        <!-- 模板包列表：名称/说明/来源/文件数/引擎/修改时间，支持上移/下移与拖拽排序 -->
        <ListView x:Name="PackageListView"
                  Grid.Row="3"
                  ItemsSource="{Binding Packages}"
                  SelectedItem="{Binding SelectedPackage}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="说明" Width="260" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="来源" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceText}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltin}" Value="True">
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="文件数" Width="70" DisplayMemberBinding="{Binding FileCount}" />
                    <GridViewColumn Header="引擎" Width="90" DisplayMemberBinding="{Binding Engine}" />
                    <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedTime}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 状态提示：内置包只读提醒与复制引导 -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
