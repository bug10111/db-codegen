<Window x:Class="DbCodeGen.App.Views.TemplatePackageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模板包管理"
        Width="1000"
        Height="580"
        MinWidth="920"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16" IsEnabled="{Binding IsIdle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：导入 zip / 导入文件夹 / 复制 / 导出 / 删除 / 刷新 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="导入 ZIP" Padding="14,5" Margin="0,0,8,0" Command="{Binding ImportZipCommand}" />
            <Button Content="导入文件夹" Padding="14,5" Margin="0,0,8,0" Command="{Binding ImportFolderCommand}" />
            <Button Content="复制为…" Padding="14,5" Margin="0,0,8,0" Command="{Binding BeginCopyCommand}" />
            <Button Content="导出 ZIP" Padding="14,5" Margin="0,0,8,0" Command="{Binding ExportCommand}" />
            <Button Content="删除" Padding="14,5" Margin="0,0,8,0" Command="{Binding DeleteCommand}" />
            <Button Content="刷新" Padding="14,5" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- 复制输入区：进入复制模式后展示，确认复制前需填写新包名 -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="10,8"
                Background="#F3F3F3"
                CornerRadius="4"
                Visibility="{Binding IsCopyModeActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CopySourceDisplay}"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,0,10,0" />
                <TextBox Text="{Binding NewPackageName, UpdateSourceTrigger=PropertyChanged}"
                         Width="220"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0" />
                <Button Content="确认复制" Padding="14,5" Margin="0,0,8,0" Command="{Binding ConfirmCopyCommand}" />
                <Button Content="取消" Padding="14,5" Command="{Binding CancelCopyCommand}" />
            </StackPanel>
        </Border>

        <!-- 模板包列表：名称/说明/来源/文件数/引擎/修改时间 -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Packages}"
                  SelectedItem="{Binding SelectedPackage}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="说明" Width="260" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="来源" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceText}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltin}" Value="True">
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="文件数" Width="70" DisplayMemberBinding="{Binding FileCount}" />
                    <GridViewColumn Header="引擎" Width="90" DisplayMemberBinding="{Binding Engine}" />
                    <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedTime}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 状态提示：内置包只读提醒与复制引导 -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
