<Window x:Class="DbCodeGen.App.Views.MigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份/恢复"
        Width="860"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 备份/恢复两页：备份页打包当前用户模板包与脱敏配置，恢复页还原并引导重输密码 -->
        <TabControl Grid.Row="0">
            <TabItem Header="备份">
                <Grid Margin="8" IsEnabled="{Binding IsIdle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 目标路径行：选择保存路径 + 刷新包清单预览 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="保存路径：" VerticalAlignment="Center" />
                        <TextBox Text="{Binding BackupTargetPath, UpdateSourceTrigger=PropertyChanged}"
                                 Width="440"
                                 VerticalContentAlignment="Center" />
                        <Button Content="浏览…"
                                Command="{Binding PickBackupTargetCommand}"
                                Padding="10,3"
                                Margin="6,0,0,0"
                                VerticalContentAlignment="Center" />
                        <Button Content="刷新预览"
                                Command="{Binding RefreshBackupPreviewCommand}"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- 预览区：将打包的用户模板包清单与配置摘要 -->
                    <GroupBox Grid.Row="1"
                              Header="将打包的用户模板包与配置摘要"
                              Margin="0,0,0,8"
                              Visibility="{Binding HasBackupPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Grid.Row="0"
                                     ItemsSource="{Binding BackupPackageRows}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}"
                                                       Margin="8,0,0,0"
                                                       Foreground="Gray" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding BackupSummaryText}"
                                       Margin="0,6,0,0"
                                       Foreground="#1565C0"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <!-- 备份页状态栏 -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding BackupStatusText}"
                               Margin="0,0,0,8"
                               Foreground="Gray"
                               TextWrapping="Wrap" />

                    <!-- 备份页操作按钮 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="创建备份"
                                Command="{Binding CreateBackupCommand}"
                                Padding="24,6" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="恢复">
                <Grid Margin="8" IsEnabled="{Binding IsIdle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 备份文件选择行：选择 .dbcg + 校验并预览 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="备份文件：" VerticalAlignment="Center" />
                        <TextBox Text="{Binding BackupFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 Width="430"
                                 VerticalContentAlignment="Center" />
                        <Button Content="浏览…"
                                Command="{Binding PickBackupFileCommand}"
                                Padding="10,3"
                                Margin="6,0,0,0"
                                VerticalContentAlignment="Center" />
                        <Button Content="校验并预览"
                                Command="{Binding InspectBackupCommand}"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- 预览区：待还原包清单 + 配置快照摘要 + 同名冲突警示 -->
                    <GroupBox Grid.Row="1"
                              Header="待还原内容与冲突检测"
                              Margin="0,0,0,8"
                              Visibility="{Binding HasRestorePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="待还原用户模板包：" FontWeight="SemiBold" />
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding RestorePackageNames}"
                                     Margin="0,4,0,6" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding RestoreConfigSummaryText}"
                                       Foreground="#1565C0"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <StackPanel Grid.Row="3"
                                        Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="同名冲突：" Foreground="#C62828" FontWeight="SemiBold" />
                                <ListBox ItemsSource="{Binding ConflictPackageNames}"
                                         MaxHeight="90"
                                         Margin="0,4,0,0"
                                         Foreground="#C62828" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 恢复页状态栏 -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding RestoreStatusText}"
                               Margin="0,0,0,8"
                               Foreground="Gray"
                               TextWrapping="Wrap" />

                    <!-- 恢复页操作按钮 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="开始恢复"
                                Command="{Binding RestoreBackupCommand}"
                                Padding="24,6" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部操作栏：操作中展示取消操作按钮，关闭按钮始终可用 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="取消操作"
                    Click="OnCancelOperationClick"
                    Padding="18,6"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="关闭"
                    IsCancel="True"
                    Click="OnCloseClick"
                    Padding="18,6" />
        </StackPanel>
    </Grid>
</Window>
