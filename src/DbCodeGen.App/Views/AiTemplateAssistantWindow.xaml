<Window x:Class="DbCodeGen.App.Views.AiTemplateAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 模板助手"
        Width="840"
        Height="800"
        MinWidth="740"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <TextBlock Grid.Row="0"
                   Text="AI 模板助手"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="写模板 / 改模板两个 Tab 共用下方参考文件上下文；参考文件按 F04「AI 参考文件限制」配置校验，内容仅注入本次对话提示词，不写盘、不进日志。"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <!-- 窗口级共享参考文件栏：位于 Tab 内容上方、TabControl 之外，写/改两 Tab 共读共改、均可增删 -->
        <ContentControl Grid.Row="2"
                        Style="{StaticResource DashedGroupBox}">
            <StackPanel Margin="4">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding ReferenceFileSummaryText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="添加文件…"
                                Command="{Binding AddReferenceFilesCommand}"
                                Padding="12,3"
                                Margin="0,0,6,0" />
                        <Button Content="移除"
                                Command="{Binding RemoveReferenceFileCommand}"
                                Padding="12,3"
                                Margin="0,0,6,0" />
                        <Button Content="清空"
                                Command="{Binding ClearReferenceFilesCommand}"
                                Padding="12,3" />
                    </StackPanel>
                </DockPanel>
                <ListView ItemsSource="{Binding ReferenceFiles}"
                          SelectedItem="{Binding SelectedReferenceFile}"
                          Height="92"
                          BorderThickness="1"
                          BorderBrush="#D0D0D0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="文件名"
                                            Width="420"
                                            DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="大小"
                                            Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} B}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="限制校验按 F04「AI 参考文件限制」配置，写/改两 Tab 一致。"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,4,0,0" />
            </StackPanel>
        </ContentControl>

        <!-- 双 Tab 容器：写模板 Tab 内容区由写模板功能填充，改模板 Tab 内容区由改模板功能填充，本窗口只提供容器 -->
        <TabControl Grid.Row="3"
                    x:Name="MainTabControl"
                    Margin="0,12,0,0">
            <TabItem Header="写模板">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 生成说明输入区（必填，灰字提示可写范围与参考镜像） -->
                    <GroupBox Grid.Row="0" Header="生成说明（必填）">
                        <StackPanel Margin="4">
                            <TextBox Text="{Binding TechStackDescription, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsInputPanelVisible}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="64"
                                     MaxHeight="96"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="可自由描述目标语言/框架与要生成的模板范围，例如：'Java + MyBatis-Plus，按参考文件全量生成整套模板' 或 'Java + MyBatis-Plus，只生成 Controller 模板'；有参考文件时默认逐文件镜像。"
                                       FontSize="11"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 样例表选择（必选，真实元数据）与刷新 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="样例表（必选）"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableTables}"
                                  SelectedItem="{Binding SelectedSampleRow}"
                                  DisplayMemberPath="RawName"
                                  IsEnabled="{Binding IsInputPanelVisible}" />
                        <Button Grid.Column="2"
                                Content="刷新样例表"
                                Command="{Binding RefreshSampleTablesCommand}"
                                Margin="8,0,0,0"
                                Padding="12,3" />
                    </Grid>

                    <!-- 样例表状态提示：未选中/读取中/已就绪三态引导 -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding SampleTableStatusText}"
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <!-- 生成到：追加到现有包 / 新建包 二选一，追加行含目标包下拉与分组输入，新建行含新包名输入 -->
                    <StackPanel Grid.Row="3"
                                IsEnabled="{Binding IsInputPanelVisible}"
                                Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="追加到现有包"
                                         GroupName="GenerateTarget"
                                         IsChecked="{Binding IsAppendMode}"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="新建包"
                                         GroupName="GenerateTarget"
                                         IsChecked="{Binding IsNewPackageMode}" />
                        </StackPanel>

                        <!-- 追加模式行：目标包下拉 + 分组目录输入，仅追加模式可见 -->
                        <Grid Margin="0,6,0,0"
                              Visibility="{Binding IsAppendMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="目标包："
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TargetPackages}"
                                      SelectedItem="{Binding TargetPackageName}"
                                      Width="160"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="分组目录："
                                       VerticalAlignment="Center"
                                       Margin="12,0,6,0" />
                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <TextBox x:Name="TargetGroupTextBox"
                                         Text="{Binding TargetGroup, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- 分组输入灰字占位提示：输入为空时可见，不可交互 -->
                                <TextBlock Text="可空，如 simple"
                                           Foreground="Gray"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=TargetGroupTextBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- 新建包模式行：新包名输入，仅新建包模式可见 -->
                        <Grid Margin="0,6,0,0"
                              Visibility="{Binding IsNewPackageMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="新包名："
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="RequestedPackageNameTextBox"
                                         Text="{Binding RequestedPackageName, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- 新包名灰字占位提示：输入为空时可见，不可交互 -->
                                <TextBlock Text="留空由 AI 命名"
                                           Foreground="Gray"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=RequestedPackageNameTextBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- 生成状态/结果区：待生成引导 / 生成中 / 成功面板 / 失败面板 按阶段切换 -->
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <!-- 待生成引导（状态机初始态） -->
                        <TextBlock Text="请填写生成说明并选择样例表，然后点击「生成」。"
                                   Foreground="Gray"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding IsIdleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- 生成中：状态文本 + 不确定进度条 -->
                        <StackPanel Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <ProgressBar IsIndeterminate="True" Height="6" />
                        </StackPanel>

                        <!-- 成功面板：包名 + 落库目录 + 跳转模板包管理 -->
                        <StackPanel Visibility="{Binding IsSuccessVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusText}"
                                       FontWeight="SemiBold"
                                       Foreground="#1A7F37" />
                            <TextBlock Text="{Binding GeneratedPackageName, StringFormat=包名：{0}}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding GeneratedTemplateDir, StringFormat=目录：{0}}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <Button Content="打开模板包管理"
                                    Command="{Binding OpenTemplateManagerCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Padding="12,4" />
                        </StackPanel>

                        <!-- 失败面板：错误清单 + 保留原文 + 复制原文 + 重试 -->
                        <StackPanel Visibility="{Binding IsFailureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusText}"
                                       FontWeight="SemiBold"
                                       Foreground="#C00000"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#C00000"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="原始 LLM 输出（供人工修复）" Margin="0,8,0,0">
                                <TextBox Text="{Binding RawLlmOutput}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         MinHeight="72"
                                         MaxHeight="110"
                                         VerticalScrollBarVisibility="Auto" />
                            </Expander>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="复制原文"
                                        Command="{Binding CopyRawOutputCommand}"
                                        Padding="12,4"
                                        Margin="0,0,8,0" />
                                <Button Content="重试"
                                        Command="{Binding GenerateCommand}"
                                        Padding="12,4" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 生成/停止 操作按钮行 -->
                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Content="生成"
                                Command="{Binding GenerateCommand}"
                                Padding="20,5"
                                Margin="0,0,8,0" />
                        <Button Content="停止"
                                Command="{Binding CancelCommand}"
                                Padding="20,5" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="改模板">
                <Grid Margin="0,8,0,0"
                      DataContext="{Binding ModifyTabViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 当前修改目标展示行：包名 / 相对路径 / 脏标记，未打开文件时提示选择 -->
                    <Border Grid.Row="0"
                            Background="#F2F7FF"
                            BorderBrush="#B8D4F0"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,6">
                        <TextBlock Text="{Binding TargetDisplayText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- 选择要修改的模板面板：勾选当前包内文件，默认勾选②区当前文件，多选时批量修改并直接保存 -->
                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,6"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="选择要修改的模板"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectionInfoText}"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="全选"
                                            Command="{Binding SelectAllCommand}"
                                            Padding="10,2"
                                            Margin="0,0,6,0" />
                                    <Button Content="清空"
                                            Command="{Binding ClearSelectionCommand}"
                                            Padding="10,2" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding SelectableFiles}"
                                     Height="110"
                                     BorderThickness="1"
                                     BorderBrush="#D0D0D0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Content="{Binding RelativePath}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="勾选多个文件时批量修改并直接保存；仅勾选当前文件时保持单文件预览-应用流程。"
                                       FontSize="11"
                                       Foreground="Gray"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 对话消息列表：用户指令与 AI 结果气泡按加入顺序滚动展示 -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <!-- 用户指令气泡：靠左浅蓝 -->
                                        <Border x:Name="UserBubble"
                                                HorizontalAlignment="Left"
                                                MaxWidth="520"
                                                Background="#E3F2FD"
                                                BorderBrush="#B3D9F5"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6">
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <!-- AI 结果气泡：靠右浅绿，含摘要/错误与展开全文 + 操作按钮 -->
                                        <StackPanel x:Name="AiBubble"
                                                    HorizontalAlignment="Right"
                                                    MaxWidth="560">
                                            <Border Background="#E8F5E9"
                                                    BorderBrush="#C8E6C9"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding FullContent}"
                                                               TextWrapping="Wrap"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               Margin="0,6,0,0"
                                                               Visibility="{Binding IsFullContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,4,0,0"
                                                        Visibility="{Binding IsResultReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Content="查看完整内容"
                                                        Command="{Binding DataContext.ViewFullContentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0" />
                                                <Button Content="应用到编辑器"
                                                        Command="{Binding DataContext.ApplyToEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0" />
                                                <Button Content="放弃"
                                                        Command="{Binding DataContext.DiscardResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Padding="8,2" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAiMessage}" Value="True">
                                            <Setter TargetName="UserBubble" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="AiBubble" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAiMessage}" Value="False">
                                            <Setter TargetName="UserBubble" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="AiBubble" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 发送中提示块：在途调用 LLM 时展示等待文案与不确定进度条，发送完成后消失回结果面板或空闲态 -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True"
                                     Width="120"
                                     Height="6"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="正在修改模板，请稍候…"
                                   Foreground="Gray"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 指令输入区：多行输入 + 灰字占位提示 + 停止/发送按钮 -->
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox x:Name="InstructionTextBox"
                                     Text="{Binding InstructionText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsIdle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="56"
                                     MaxHeight="90"
                                     VerticalScrollBarVisibility="Auto" />
                            <!-- 指令输入区灰字占位提示：输入为空且未在发送时可见，不可交互 -->
                            <TextBlock Text="描述你想如何修改当前模板…（可沿用参考文件上下文）"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Margin="6,8,6,6"
                                       VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=InstructionTextBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">
                            <Button Content="停止"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="20,5"
                                    Margin="0,0,8,0" />
                            <Button Content="发送"
                                    Command="{Binding SendCommand}"
                                    Padding="20,5" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
