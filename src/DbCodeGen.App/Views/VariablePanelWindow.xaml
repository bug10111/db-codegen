<Window x:Class="DbCodeGen.App.Views.VariablePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="变量面板"
        Width="380"
        Height="520"
        MinWidth="320"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 当前表展示与操作引导 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="当前表" FontSize="11" Foreground="Gray" />
            <TextBlock Text="{Binding TableDisplayName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="双击叶子节点插入表达式到模板编辑器光标处"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- 变量表达式树：按表变量/列变量/工具函数/包变量分组展示 -->
        <TreeView x:Name="VariableTree"
                  Grid.Row="1"
                  ItemsSource="{Binding RootNodes}"
                  MouseDoubleClick="OnTreeDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Window>
