<Window x:Class="DbCodeGen.App.Views.TypeMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="类型映射"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 说明：映射优先级与生效方式 -->
        <TextBlock Grid.Row="0"
                   Text="数据库类型 → Java 类型映射。生成代码时优先命中本表，未命中再查当前模板包 typeMap。保存后即时生效。"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   Margin="0,0,0,10" />

        <!-- 映射表编辑：数据库类型/目标类型/导包/备注 四列可编辑 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="数据库类型" Binding="{Binding DbType, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                <DataGridTextColumn Header="目标类型" Binding="{Binding TargetType, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="导包" Binding="{Binding Import, UpdateSourceTrigger=PropertyChanged}" Width="1.8*" />
                <DataGridTextColumn Header="备注" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="1.8*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 编辑操作：新增/删除/恢复默认/导入/导出 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="新增行" Padding="12,4" Margin="0,0,8,0" Command="{Binding AddRowCommand}" />
            <Button Content="删除选中" Padding="12,4" Margin="0,0,8,0" Command="{Binding RemoveRowCommand}" />
            <Button Content="恢复默认" Padding="12,4" Margin="0,0,8,0" Command="{Binding RestoreDefaultsCommand}" />
            <Button Content="导入…" Padding="12,4" Margin="0,0,8,0" Command="{Binding ImportCommand}" />
            <Button Content="导出…" Padding="12,4" Command="{Binding ExportCommand}" />
        </StackPanel>

        <!-- 底部操作：保存写入配置，关闭不保存 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Padding="24,6" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="关闭" Padding="24,6" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
