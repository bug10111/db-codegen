<Window x:Class="DbCodeGen.App.Views.SqlExecutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="SQL 执行面板"
        Width="960"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：数据源选择 + SQL 文件打开/保存 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="数据源：" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding DataSources}"
                      SelectedItem="{Binding SelectedDataSource}"
                      DisplayMemberPath="Name"
                      VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="（默认当前连接，面板内切换仅作用于本面板；单次执行单条语句）"
                       Margin="8,0,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3"
                    Content="打开 SQL…"
                    Command="{Binding OpenSqlCommand}"
                    Padding="12,4"
                    Margin="8,0,0,0"
                    VerticalContentAlignment="Center" />
            <Button Grid.Column="4"
                    Content="保存 SQL…"
                    Command="{Binding SaveSqlCommand}"
                    Padding="12,4"
                    Margin="8,0,0,0"
                    VerticalContentAlignment="Center" />
        </Grid>

        <!-- SQL 编辑器：AvalonEdit 内置 SQL 高亮，展示行号 -->
        <GroupBox Grid.Row="1" Header="SQL 编辑器" Margin="0,8,0,0">
            <avalonedit:TextEditor x:Name="SqlEditor"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   TextChanged="OnSqlEditorTextChanged" />
        </GroupBox>

        <!-- 执行参数与操作：超时/行上限/危险确认 + 执行与取消 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="超时(秒)：" VerticalAlignment="Center" />
            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Width="56"
                     VerticalContentAlignment="Center"
                     ToolTip="命令超时秒数，0 表示不超时，需谨慎使用" />
            <TextBlock Text="最大结果行：" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding MaxResultRows, UpdateSourceTrigger=PropertyChanged}"
                     Width="80"
                     VerticalContentAlignment="Center"
                     ToolTip="结果行读取上限，超限截断并提示" />
            <CheckBox Content="危险语句执行前确认"
                      IsChecked="{Binding ConfirmDangerousSql}"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      ToolTip="DROP/TRUNCATE/无 WHERE 的 DELETE·UPDATE 执行前弹确认" />
            <Button Content="执行"
                    IsDefault="True"
                    Command="{Binding ExecuteCommand}"
                    Padding="20,5"
                    Margin="24,0,0,0"
                    VerticalContentAlignment="Center" />
            <Button Content="取消执行"
                    Command="{Binding CancelCommand}"
                    Padding="14,5"
                    Margin="8,0,0,0"
                    VerticalContentAlignment="Center"
                    Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- 结果与错误区域：摘要 + 查询结果表格 / 错误红色展示 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 结果摘要：查询行数/影响行数 + 耗时 -->
            <TextBlock Grid.Row="0"
                       Text="{Binding ResultSummaryText}"
                       Margin="0,0,0,4"
                       Foreground="#1565C0"
                       TextWrapping="Wrap" />

            <!-- 查询结果表格：列自动生成，表头由代码后置替换为“列名（显示类型）” -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding ResultTable}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="OnResultGridAutoGeneratingColumn"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Visibility="{Binding HasQueryResult, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 错误红色展示：脱敏错误码与错误描述 -->
            <Border Grid.Row="1"
                    Background="#FDECEA"
                    BorderBrush="#C62828"
                    BorderThickness="1"
                    Padding="10"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorText}"
                           Foreground="#C62828"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           FontFamily="Consolas"
                           FontSize="12" />
            </Border>
        </Grid>

        <!-- 底部状态栏：执行进度与结果状态 -->
        <StatusBar Grid.Row="4" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="Gray"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
