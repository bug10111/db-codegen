<Window x:Class="DbCodeGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="DbCodeGen 代码生成器"
        Height="880"
        Width="1440"
        FontSize="14"
        MinHeight="700"
        MinWidth="1120"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 顶部菜单标题：加大字号与内边距，与工具栏按钮视觉一致；仅顶层菜单生效，子菜单保持默认字号 -->
        <Style TargetType="MenuItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="TopLevelHeader">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Padding" Value="10,6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="TopLevelItem">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Padding" Value="10,6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>

        <!-- 顶部菜单：文件承载设置与退出，工具承载数据源管理/刷新表/SQL 执行面板/模板包管理/类型映射/备份恢复，帮助承载关于 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="设置…" Click="OnOpenSettingsClick" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="数据源管理…" Click="OnManageDataSourcesClick" />
                <MenuItem Header="刷新表" Click="OnRefreshTablesClick" />
                <Separator />
                <MenuItem Header="SQL 执行面板…" Click="OnOpenSqlPanelClick" />
                <MenuItem Header="模板包管理…" Click="OnOpenTemplateManagerClick" />
                <MenuItem Header="类型映射…" Click="OnOpenTypeMappingClick" />
                <MenuItem Header="备份/恢复…" Click="OnOpenMigrationClick" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于 DbCodeGen…" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- 工具栏：数据源下拉切换当前连接 + 数据源管理入口 -->
        <Border DockPanel.Dock="Top"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="数据源：" VerticalAlignment="Center" />
                <ComboBox x:Name="DataSourceComboBox"
                          MinWidth="220"
                          DisplayMemberPath="Name"
                          VerticalContentAlignment="Center"
                          SelectionChanged="OnDataSourceComboBoxSelectionChanged" />
                <Button x:Name="ManageDataSourcesButton"
                        Content="管理…"
                        Margin="8,0,0,0"
                        VerticalContentAlignment="Center"
                        Click="OnManageDataSourcesClick" />
            </StackPanel>
        </Border>

        <!-- 主区四区布局骨架：上区三栏为表列表区/模板区/预览区，下区为生成栏，两区之间可拖动调整高度比例 -->
        <Grid Margin="12" x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="300" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="280" />
            </Grid.RowDefinitions>

            <!-- 上下区拖拽分隔条：拖动调整上区与下区(生成栏)的高度比例 -->
            <GridSplitter Grid.Row="1"
                          Height="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="#EEEEEE"
                          BorderBrush="#DDDDDD"
                          BorderThickness="0,1,0,1"
                          Cursor="SizeNS"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          ToolTip="拖动调整上下区域高度比例" />

            <!-- 上区三栏布局：①表列表区固定像素起始、②模板区与③预览区按星号均分，列间纵向分隔条可拖动 -->
            <Grid Grid.Row="0" x:Name="TopColumnsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="250" />
                </Grid.ColumnDefinitions>

                <!-- 表列表区：数据源表清单、搜索过滤与多选勾选 -->
                <GroupBox Grid.Column="0" x:Name="TableListPanel" Header="① 表列表区" Margin="0,0,4,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 表区工具条：全选/反选/清空/刷新表 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="全选"
                                    Command="{Binding SelectAllCommand}"
                                    Margin="0,0,4,0"
                                    VerticalContentAlignment="Center" />
                            <Button Content="反选"
                                    Command="{Binding InvertSelectionCommand}"
                                    Margin="0,0,4,0"
                                    VerticalContentAlignment="Center" />
                            <Button Content="清空"
                                    Command="{Binding ClearSelectionCommand}"
                                    Margin="0,0,4,0"
                                    VerticalContentAlignment="Center" />
                            <Button Content="刷新表"
                                    Command="{Binding RefreshCommand}"
                                    Margin="8,0,0,0"
                                    VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- 搜索框：按表名或注释实时过滤可见行 -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"
                                 VerticalContentAlignment="Center"
                                 ToolTip="按表名或注释搜索，实时过滤，不影响勾选集合" />

                        <!-- 表清单 DataGrid：勾选列 + 表名列 + 注释列，默认按表名排序 -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding TableView}"
                                  SelectedItem="{Binding SelectedRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="50" />
                                <DataGridTextColumn Header="表名" Binding="{Binding RawName}" Width="*" SortMemberPath="RawName" IsReadOnly="True" />
                                <DataGridTextColumn Header="注释" Binding="{Binding Comment}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 状态栏：连接状态与表数量、勾选数量 -->
                        <TextBlock Grid.Row="3"
                                   Text="{Binding StatusText}"
                                   Margin="0,4,0,0"
                                   Foreground="Gray"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </GroupBox>

                <!-- 上区三栏纵向拖拽分隔条：拖动调整①表列表区与②模板区的宽度比例 -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#E0E0E0"
                              BorderBrush="#DDDDDD"
                              BorderThickness="0,0,1,0"
                              Cursor="SizeWE"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              ToolTip="拖动调整①表列表区与②模板区宽度" />

                <!-- 模板区：模板包与文件树 + AvalonEdit 编辑器 + 变量面板入口 -->
                <GroupBox Grid.Column="2" x:Name="TemplatePanel" Header="② 模板区" Margin="4,0,4,0">
                    <Grid Margin="4" IsEnabled="{Binding IsIdle}">
                        <Grid.InputBindings>
                            <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
                        </Grid.InputBindings>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="190" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 模板区工具条：包下拉 / 模板包管理 / 刷新 -->
                        <ContentControl Grid.Row="0" Style="{StaticResource DashedGroupBox}" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="模板包：" VerticalAlignment="Center" Foreground="#666666" />
                                <ComboBox ItemsSource="{Binding Packages}"
                                          SelectedItem="{Binding SelectedPackage}"
                                          DisplayMemberPath="Name"
                                          MinWidth="150"
                                          VerticalContentAlignment="Center" />
                                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                                <Button Content="模板包管理"
                                        Click="OnOpenTemplateManagerClick"
                                        VerticalContentAlignment="Center" />
                                <Button Content="刷新"
                                        Command="{Binding RefreshCommand}"
                                        Margin="4,0,0,0"
                                        VerticalContentAlignment="Center" />
                            </StackPanel>
                        </ContentControl>

                        <!-- 文件工具条：新增/重命名/删除模板，仅用户包可用；AI 入口按钮随②区整体繁忙禁用 -->
                        <ContentControl Grid.Row="1" Style="{StaticResource DashedGroupBox}" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="新增模板"
                                        Command="{Binding AddTemplateFileCommand}"
                                        VerticalContentAlignment="Center" />
                                <Button Content="重命名"
                                        Command="{Binding RenameTemplateFileCommand}"
                                        Margin="4,0,0,0"
                                        VerticalContentAlignment="Center"
                                        ToolTip="重命名选中的模板文件相对路径，内置包只读不可重命名" />
                                <Button Content="删除模板"
                                        Command="{Binding DeleteTemplateFileCommand}"
                                        Margin="4,0,0,0"
                                        VerticalContentAlignment="Center" />
                                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                                <Button Content="AI 写模板"
                                        Click="OnAiWriteTemplateClick"
                                        VerticalContentAlignment="Center"
                                        ToolTip="打开「AI 模板助手」并切到写模板 Tab" />
                                <Button Content="AI 改模板"
                                        Click="OnAiModifyTemplateClick"
                                        Margin="4,0,0,0"
                                        VerticalContentAlignment="Center"
                                        ToolTip="打开「AI 模板助手」并切到改模板 Tab" />
                            </StackPanel>
                        </ContentControl>

                        <!-- 包内模板文件树：排序工具条 + checkbox 表达“勾选到层”运行时勾选态，选中文件后加载编辑器 -->
                        <ContentControl Grid.Row="2" Style="{StaticResource DashedGroupBox}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 文件顺序排序工具条：上移/下移边界由命令可用性驱动禁用，恢复默认在存在顺序记忆时可点 -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                                    <Button Content="上移"
                                            Command="{Binding MoveFileUpCommand}"
                                            VerticalContentAlignment="Center"
                                            ToolTip="将选中的模板文件上移一位" />
                                    <Button Content="下移"
                                            Command="{Binding MoveFileDownCommand}"
                                            Margin="4,0,0,0"
                                            VerticalContentAlignment="Center"
                                            ToolTip="将选中的模板文件下移一位" />
                                    <Button Content="恢复默认排序"
                                            Command="{Binding ResetFileOrderCommand}"
                                            Margin="4,0,0,0"
                                            VerticalContentAlignment="Center"
                                            ToolTip="清除当前包的排序记忆，恢复模板包清单声明顺序" />
                                    <TextBlock Text="可按住拖拽调整顺序"
                                               Margin="12,0,0,0"
                                               FontSize="11"
                                               Foreground="Gray"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ListView Grid.Row="1"
                                          x:Name="TemplateFileListView"
                                          ItemsSource="{Binding Files}"
                                          SelectedItem="{Binding SelectedFile}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnTemplateFileListItemPreviewMouseRightButtonDown" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="新增模板" Command="{Binding AddTemplateFileCommand}" />
                                    <MenuItem Header="重命名模板" Command="{Binding RenameTemplateFileCommand}" />
                                    <MenuItem Header="删除模板" Command="{Binding DeleteTemplateFileCommand}" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center"
                                                  Click="OnTemplateFileCheckBoxClick"
                                                  ToolTip="勾选到层：勾选后该文件参与批量生成" />
                                        <TextBlock Text="{Binding RelativeTemplatePath}"
                                                   ToolTip="{Binding OutputPath}"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </ContentControl>

                        <!-- 编辑器工具条：插入变量 / 保存，作用于当前编辑的模板内容 -->
                        <ContentControl Grid.Row="3" Style="{StaticResource DashedGroupBox}" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="插入变量"
                                        Command="{Binding OpenVariablePanelCommand}"
                                        VerticalContentAlignment="Center"
                                        ToolTip="打开变量树，双击把 {{变量}} 表达式插入编辑器光标处" />
                                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                                <Button Content="保存"
                                        Command="{Binding SaveCommand}"
                                        VerticalContentAlignment="Center"
                                        ToolTip="保存当前模板文件内容（Ctrl+S）" />
                            </StackPanel>
                        </ContentControl>

                        <!-- Scriban 模板编辑器，高亮语言由文件名推导 -->
                        <ContentControl Grid.Row="4" Style="{StaticResource DashedGroupBox}">
                            <avalonedit:TextEditor x:Name="TemplateEditor"
                                                   FontFamily="Consolas"
                                                   FontSize="14"
                                                   ShowLineNumbers="True"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto"
                                                   TextChanged="OnTemplateEditorTextChanged" />
                        </ContentControl>

                        <!-- 状态栏：加载/保存结果与脏标记 -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="Gray"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DirtyMark}"
                                       Margin="8,0,0,0"
                                       Foreground="Gray"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 上区三栏纵向拖拽分隔条：拖动调整②模板区与③预览区的宽度比例 -->
                <GridSplitter Grid.Column="3"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#E0E0E0"
                              BorderBrush="#DDDDDD"
                              BorderThickness="0,0,1,0"
                              Cursor="SizeWE"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              ToolTip="拖动调整②模板区与③预览区宽度" />

                <!-- 预览区：预览表下拉 + 渲染代码展示 -->
                <GroupBox Grid.Column="4" x:Name="PreviewPanel" Header="③ 预览区">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 预览表选择，与变量面板共用同一当前表 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="预览表：" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableTables}"
                                      SelectedItem="{Binding SelectedTableRow}"
                                      DisplayMemberPath="RawName"
                                      MinWidth="170"
                                      VerticalContentAlignment="Center" />
                            <TextBlock Text="（未选择时跟随①区当前表）"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       Foreground="Gray"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 渲染真实代码展示，只读；悬停时滚轮滚动经 PreviewMouseWheel 接管 -->
                        <avalonedit:TextEditor x:Name="PreviewEditor"
                                               Grid.Row="1"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               IsReadOnly="True"
                                               ShowLineNumbers="True"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"
                                               PreviewMouseWheel="OnRegionMouseWheel" />

                        <!-- 预览状态：渲染耗时或结构化错误定位 -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding StatusText}"
                                   Margin="0,4,0,0"
                                   Foreground="Gray"
                                   TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- 生成栏：输出根配置、预览待写/生成、待写清单、结果统计与生成日志 -->
            <GroupBox Grid.Row="2" x:Name="GenerationPanel" Header="④ 生成栏" Margin="0,8,0,0">
                <Grid Margin="4" IsEnabled="{Binding IsIdle}" x:Name="GenerationInnerGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 路径配置行：工作区根与代码目录配套使用，紧挨一行横排 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="工作区根：" VerticalAlignment="Center" />
                        <TextBox Text="{Binding WorkspaceRoot, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="260"
                                 VerticalContentAlignment="Center"
                                 ToolTip="项目根目录，代码落盘的绝对根前缀" />
                        <Button Content="浏览…"
                                Command="{Binding PickWorkspaceRootCommand}"
                                Margin="4,0,0,0"
                                VerticalContentAlignment="Center" />
                        <TextBlock Text="代码目录：" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox Text="{Binding CodeDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="260"
                                 VerticalContentAlignment="Center"
                                 ToolTip="package（如 com.example.common），用于 package 声明与 import；代码实际落盘在 工作区根/src/main/java/&lt;包名目录&gt;/…" />
                    </StackPanel>

                    <!-- 操作行：预览待写/生成按钮 + 待写清单摘要 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,4">
                        <Button Content="预览待写"
                                Command="{Binding PreviewCommand}"
                                VerticalContentAlignment="Center" />
                        <Button Content="生成"
                                Command="{Binding GenerateCommand}"
                                Margin="8,0,0,0"
                                VerticalContentAlignment="Center" />
                        <TextBlock Text="{Binding PreviewSummaryText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#1565C0" />
                    </StackPanel>

                    <!-- 待写清单：表名/分类/相对路径，dry-run 新增·覆盖·跳过分类展示 -->
                    <DataGrid Grid.Row="2"
                              MinHeight="60"
                              ItemsSource="{Binding PreviewEntries}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表名" Binding="{Binding TableName}" Width="120" />
                            <DataGridTextColumn Header="分类" Binding="{Binding ActionText}" Width="56" />
                            <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" />
                            <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 拖拽分隔条：调整底部面板（状态/结果/日志）高度 -->
                    <GridSplitter Grid.Row="3"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows"
                                  Background="#E0E0E0" />

                    <!-- 底部面板：操作状态/结果统计/生成日志，经上方分隔条拖拽调整高度 -->
                    <Grid Grid.Row="4" MinHeight="64">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 操作状态：进行中进度与阶段结果 -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding StatusText}"
                                   Margin="0,4,0,2"
                                   Foreground="Gray"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 结果统计：生成/覆盖/跳过/失败四计数 -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding ResultSummaryText}"
                                   Margin="0,0,0,2"
                                   Foreground="#2E7D32"
                                   FontWeight="SemiBold" />

                        <!-- 生成日志：只读多行展示，纵向滚动，随面板拖拽调整高度；新日志到达时按需自动滚动到底部；悬停时滚轮滚动经 PreviewMouseWheel 接管 -->
                        <TextBox Grid.Row="2"
                                 x:Name="LogTextBox"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 MinHeight="40"
                                 Background="#FAFAFA"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 TextChanged="OnLogTextChanged"
                                 PreviewMouseWheel="OnRegionMouseWheel" />
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
